# Local/dev: copy to .env and paste your NASA FIRMS MAP_KEY.
# Published Cursor app: bind FIRMS_MAP_KEY as an app secret (Dashboard → Secrets).
FIRMS_MAP_KEY=your_key_here

# Optional. Set to false on a public demo so visitors cannot share your quota
# (they can still paste their own MAP_KEY in the UI). Default: host key allowed.
# FIRMS_ALLOW_HOST_KEY=true
