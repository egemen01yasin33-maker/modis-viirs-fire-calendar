# NASA FIRMS MAP_KEY for live NRT compare.
# Local: copy to .env. Published Cursor app: bind as app secret FIRMS_MAP_KEY.
FIRMS_MAP_KEY=your_key_here

# Shared access code required for Live FIRMS on the public FastAPI UI
# (not the MAP_KEY). Bind as Cursor secret NRT_GATE_PASSWORD.
NRT_GATE_PASSWORD=choose_a_demo_code
